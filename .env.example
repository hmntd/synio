APP_NAME=Synio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://synio.localhost
APP_DOMAIN=synio.localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=synio
DB_USERNAME=sail
DB_PASSWORD=password

# Multi-tenancy
TENANCY_SUBDOMAIN=true

# Redmine
REDMINE_BASE_URL=http://localhost:3000
# For Docker internal communication between Laravel and Redmine:
# REDMINE_INTERNAL_URL=http://redmine:3000

# Slack
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=

# Telegram
TELEGRAM_BOT_TOKEN=

# Reminders
DAILY_REMINDER_CUTOFF=18:00
WEEKLY_REMINDER_WEEKDAY=FRI
TIMEZONE=Europe/Kyiv

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.synio.localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@synio.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Redmine Docker ports (optional overrides)
FORWARD_REDMINE_PORT=3000
FORWARD_REDMINE_DB_PORT=5433